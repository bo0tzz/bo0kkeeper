# Copy to .env (gitignored) for docker compose dev.
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=bo0kkeeper

# Server
HOST=0.0.0.0
PORT=2283

# Connect-string equivalents for sql-tools migrations CLI
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bo0kkeeper

# OIDC
OIDC_ISSUER=https://idp.example.local
OIDC_CLIENT_ID=bo0kkeeper
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:2283/api/auth/callback
OIDC_SCOPES=openid email profile
OIDC_POST_LOGIN_PATH=/

# Cookies
# Set to false in local dev (no HTTPS); true in production.
COOKIE_SECURE=false
