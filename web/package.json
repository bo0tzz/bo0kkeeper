{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "check:svelte": "svelte-check --no-tsconfig --fail-on-warnings",
    "check:typescript": "tsc --noEmit",
    "check": "pnpm run check:svelte && pnpm run check:typescript",
    "check:code": "pnpm run format && pnpm run lint && pnpm run check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest --passWithNoTests",
    "test:browser": "playwright test --config playwright.config.ts",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@bo0kkeeper/sdk": "workspace:*",
    "@immich/ui": "^0.61.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.27.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^24.10.9",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.12.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.0.0",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.48.0",
    "svelte-check": "^4.1.5",
    "svelte-eslint-parser": "^1.3.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.2",
    "vitest": "^3.0.0"
  }
}
