{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "check:svelte": "svelte-check --no-tsconfig --fail-on-warnings",
    "check:typescript": "tsc --noEmit",
    "check": "pnpm run check:svelte && pnpm run check:typescript",
    "check:code": "pnpm run format && pnpm run lint && pnpm run check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest --passWithNoTests",
    "test:browser": "playwright test --config playwright.config.ts",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@bo0kkeeper/sdk": "workspace:*",
    "@immich/ui": "^0.81.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.0.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "svelte-eslint-parser": "^1.6.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.8"
  }
}
