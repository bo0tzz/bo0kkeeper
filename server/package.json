{
  "name": "bo0kkeeper",
  "version": "0.1.0",
  "description": "Bookkeeping automation server",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "pnpm run start:dev",
    "start:dev": "nest start --watch --",
    "start:debug": "nest start --debug 0.0.0.0:9230 --watch --",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "check": "tsc --noEmit",
    "check:code": "pnpm run format && pnpm run lint && pnpm run check",
    "check:all": "pnpm run check:code && pnpm run test --run",
    "test": "vitest --config test/vitest.config.mjs --passWithNoTests",
    "test:cov": "vitest --config test/vitest.config.mjs --passWithNoTests --coverage",
    "test:medium": "vitest --config test/vitest.config.medium.mjs",
    "test:e2e": "vitest --config test/vitest.config.e2e.mjs",
    "migrations:generate": "sql-tools -u ${DATABASE_URL:-postgres://postgres:postgres@localhost:5432/bo0kkeeper} migrations generate",
    "migrations:create": "sql-tools -u ${DATABASE_URL:-postgres://postgres:postgres@localhost:5432/bo0kkeeper} migrations create",
    "migrations:run": "sql-tools -u ${DATABASE_URL:-postgres://postgres:postgres@localhost:5432/bo0kkeeper} migrations run",
    "migrations:revert": "sql-tools -u ${DATABASE_URL:-postgres://postgres:postgres@localhost:5432/bo0kkeeper} migrations revert",
    "migrations:debug": "sql-tools -u ${DATABASE_URL:-postgres://postgres:postgres@localhost:5432/bo0kkeeper} migrations generate --debug",
    "scrub": "node ./dist/bin/scrub.js",
    "replay": "node ./dist/bin/replay.js",
    "sync:open-api": "node ./dist/bin/sync-open-api.js",
    "import-sns": "node ./dist/bin/import-sns.js"
  },
  "dependencies": {
    "@immich/sql-tools": "^0.5.1",
    "@nestjs/common": "^11.0.4",
    "@nestjs/core": "^11.0.4",
    "@nestjs/platform-express": "^11.0.4",
    "@nestjs/swagger": "^11.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jose": "^5.10.0",
    "kysely": "^0.28.2",
    "kysely-postgres-js": "^3.0.0",
    "nestjs-cls": "^5.0.0",
    "nestjs-kysely": "^3.1.2",
    "nestjs-zod": "^5.3.0",
    "openid-client": "^6.1.0",
    "pg-boss": "^10.0.0",
    "postgres": "^3.4.8",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sanitize-filename": "^1.6.3",
    "sirv": "^3.0.0",
    "uuid": "^11.1.0",
    "validator": "^13.12.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.4",
    "@swc/core": "^1.4.14",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.9",
    "@types/validator": "^13.15.2",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.0.0",
    "testcontainers": "^11.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.45.0",
    "unplugin-swc": "^1.4.5",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {}
}
