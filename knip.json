{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/browser-harness/*.mjs"
      ]
    },
    "server": {
      "entry": [
        "src/main.ts",
        "src/bin/*.ts",
        "src/schema/migrations/*.ts",
        "test/medium/globalSetup.ts",
        "test/vitest.config.mjs",
        "test/vitest.config.medium.mjs",
        "test/vitest.config.e2e.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "web": {
      "entry": [
        "playwright.config.ts",
        "e2e/specs/*.spec.ts"
      ]
    },
    "open-api/typescript-sdk": {
      "entry": [
        "src/index.ts"
      ]
    }
  }
}
