{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/browser-harness/*.mjs",
        "scripts/dev-oidc.mjs"
      ]
    },
    "server": {
      "entry": [
        "src/main.ts",
        "src/bin/*.ts",
        "src/schema/index.ts",
        "src/schema/migrations/*.ts",
        "test/medium/globalSetup.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ],
      "ignoreExportsUsedInFile": true,
      "ignoreUnresolved": [
        "test/medium/globalSetup.ts"
      ]
    },
    "web": {
      "entry": [
        "e2e/specs/*.spec.ts"
      ]
    },
    "open-api/typescript-sdk": {}
  }
}
