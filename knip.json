{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": [
    "format",
    "check"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "tools/browser-harness/*.mjs"
      ]
    },
    "server": {
      "entry": [
        "src/main.ts",
        "src/bin/*.ts",
        "src/schema/index.ts",
        "src/schema/migrations/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ],
      "ignoreExportsUsedInFile": true
    },
    "web": {
      "entry": [
        "e2e/specs/*.spec.ts",
        "src/hooks.ts"
      ]
    },
    "open-api/typescript-sdk": {}
  }
}
